{
  "name": "hyperion-legacy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:sweep": "vitest run --mode sweep src/lib/game/firstRunsGoldens",
    "test:sweep:training": "vitest run --mode sweep src/lib/game/safeFirstExpedition",
    "test:sweep:si": "vitest run --mode sweep src/lib/game/siMemberGear.sweep",
    "test:sweep:ramp": "vitest run --mode sweep src/lib/game/safeFirstRamp",
    "test:sim": "vitest run --mode sim --reporter=verbose src/lib/game/sim"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.2",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "break_infinity.js": "^2.2.0"
  }
}
